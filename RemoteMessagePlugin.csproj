<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CreateIcpx>true</CreateIcpx>
    <RootNamespace>RemoteMessagePlugin</RootNamespace>
    <!-- 本地开发时 SDK 仓库路径；也可通过 -p:InkCanvasPluginSdkDir=... 覆盖 -->
    <InkCanvasPluginSdkDir Condition="'$(InkCanvasPluginSdkDir)' == ''">E:\Develop\community</InkCanvasPluginSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(InkCanvasPluginSdkDir)\InkCanvas.PluginSdk.csproj" />
  </ItemGroup>

  <Import Project="$(InkCanvasPluginSdkDir)\InkCanvas.PluginSdk.targets"
          Condition="Exists('$(InkCanvasPluginSdkDir)\InkCanvas.PluginSdk.targets')" />

  <ItemGroup>
    <EmbeddedResource Include="WebUI.html" LogicalName="RemoteMessagePlugin.WebUI.html" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="notify-normal-new.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
